{
  "manifest_version": 3,
  "name": "Store Sync WhatsApp Sender",
  "version": "1.97",
  "description": "Change cursor style and start WhatsApp chats from a sidebar.",
  "permissions": ["scripting", "activeTab", "tabs", "cookies", "storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://testv3.websitedemolynk.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WhatsApp Sidebar",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["env.js", "content.js"],
      "css": ["sidebar.css"]
    },
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": ["posBridge.js"],
      "run_at": "document_idle"
    }
  ]
}
