{
  "manifest_version": 3,
  "name": "Store Sync WhatsApp Sender",
  "version": "1.60",
  "description": "Change cursor style and start WhatsApp chats from a sidebar.",
  "permissions": ["scripting", "activeTab", "tabs", "cookies"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WhatsApp Sidebar",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"]
    }
  ]
}
