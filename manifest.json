{
  "manifest_version": 3,
  "name": "Store Sync POS Messenger for WhatsApp Web",
  "version": "1.109",
  "description": "Sends customer messages queued in your Store Sync POS via WhatsApp Web and saves replies to the POS. Not affiliated with WhatsApp.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "cookies", "storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://testv3.websitedemolynk.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WhatsApp Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["env.js", "content.js"],
      "css": ["sidebar.css"]
    },
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://testv3.websitedemolynk.com/*"
      ],
      "js": ["posBridge.js"],
      "run_at": "document_idle"
    }
  ]
}
